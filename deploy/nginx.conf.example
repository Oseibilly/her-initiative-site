# Nginx reverse proxy config for HER Initiative
# Copy to /etc/nginx/sites-available/her-initiative on the VPS, edit the
# domain name below, then symlink it into sites-enabled (see DEPLOYMENT.md).

server {
    listen 80;
    listen [::]:80;
    server_name herinitiativegh.org www.herinitiativegh.org;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
