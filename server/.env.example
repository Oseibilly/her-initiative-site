# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/her_initiative

# Port the server listens on
PORT=3000

# SMTP settings used to email a notification for every new sign-up.
# Works with Gmail (app password), or any transactional provider
# (Resend, SendGrid, Mailgun, etc.) via their SMTP relay.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="HER Initiative <no-reply@herinitiative.org>"

# Inbox that receives the sign-up notification emails
NOTIFY_EMAIL=hello@herinitiative.org

# Long random string used to sign admin login sessions — generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Set to "production" when deployed behind HTTPS — makes the admin login
# cookie Secure-only. Leave unset for local development over plain HTTP.
NODE_ENV=development
